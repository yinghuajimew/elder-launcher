<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <!-- 时钟区：数字 / 指针 / 双时钟，由代码按设置填充 -->
            <LinearLayout
                android:id="@+id/clock_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#555555"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8A6D3B"
                android:textSize="24sp" />
        </LinearLayout>

        <com.elder.launcher.desktop.PageScrollView
            android:id="@+id/scroll_pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pages_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </com.elder.launcher.desktop.PageScrollView>
    </LinearLayout>

    <!-- 左上角：设置 -->
    <Button
        android:id="@+id/btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:minWidth="56dp"
        android:minHeight="44dp"
        android:text="@string/btn_settings"
        android:textSize="14sp" />

    <!-- 右上角：退出锁定（长按解除） -->
    <Button
        android:id="@+id/btn_exit_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:minWidth="56dp"
        android:minHeight="44dp"
        android:text="@string/btn_exit_lock"
        android:textSize="14sp" />

    <!-- 拖动过程中出现的删除区：把图标拖到这里即可从桌面移除。
         始终占据布局（避免拖动开始时来不及布局），用 alpha 控制显隐。 -->
    <TextView
        android:id="@+id/tv_delete_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:alpha="0"
        android:background="@drawable/bg_delete_zone"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/delete_zone"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</FrameLayout>
